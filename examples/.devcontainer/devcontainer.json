{
    "name": "Haskell Dev",
    "image": "ghcr.io/stetrevor/haskell-dev:ghc-9.10.3",
    "initializeCommand": "docker pull ghcr.io/stetrevor/haskell-dev:nano || true",
    "mounts": [
        "source=haskell-cabal-global,target=/home/vscode/.cabal,type=volume"
    ],
    "remoteEnv": {
        "PATH": "/home/vscode/.cabal/bin:${containerEnv:PATH}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "haskell.haskell"
            ],
            "settings": {
                "haskell.manageHLS": "PATH",
                "haskell.serverExecutablePath": "/home/vscode/.ghcup/bin/haskell-language-server-wrapper",
                "haskell.formattingProvider": "fourmolu",
                "[haskell]": {
                    "editor.defaultFormatter": "haskell.haskell",
                    "editor.formatOnSave": true
                },
                "[cabal]": {
                    "editor.defaultFormatter": "haskell.haskell",
                    "editor.formatOnSave": true
                }
            }
        }
    },
    "remoteUser": "vscode"
}
